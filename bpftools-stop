#!/bin/bash
# -*- mode: sh; indent-tabs-mode: nil; sh-basic-offset: 4 -*-
# vim: autoindent tabstop=4 shiftwidth=4 expandtab softtabstop=4 filetype=bash

exec >>bpftools-start-stderrout.txt
exec 2>&1

echo "Stopping bpftools"

if [ -f bpftools-pids.txt ]; then
    while read -r pid; do
        if kill -0 "$pid" 2>/dev/null; then
            echo "Stopping pid $pid"
            kill "$pid"
        fi
    done < bpftools-pids.txt
    # give bpftrace a moment to flush output
    sleep 1
    while read -r pid; do
        if kill -0 "$pid" 2>/dev/null; then
            echo "Force killing pid $pid"
            kill -9 "$pid"
        fi
    done < bpftools-pids.txt
    /bin/rm -f bpftools-pids.txt
else
    echo "No bpftools-pids.txt found, nothing to stop"
fi

echo "bpftools stopped"
