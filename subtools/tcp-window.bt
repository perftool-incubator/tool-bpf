#!/usr/bin/bpftrace

/*
 * tcp-window: TCP congestion and flow-control state per connection.
 *
 * Uses kprobe:tcp_rcv_established rather than tracepoint:tcp:tcp_probe
 * for cross-kernel compatibility.  The tracepoint's field set varies
 * by kernel version (e.g., 'skaddr' is absent on RHEL 9.4 / 5.14.x),
 * while the kprobe approach accesses the sock struct directly via BTF
 * and works on any kernel with CONFIG_DEBUG_INFO_BTF=y.
 *
 * Requires: kernel with CONFIG_DEBUG_INFO_BTF=y.
 *
 * Output format (space-separated, one line per event):
 *   nsecs src sport dst dport snd_cwnd ssthresh snd_wnd srtt_us rcv_wnd
 *
 *   nsecs     CLOCK_MONOTONIC nanoseconds (convert to epoch via boot-epoch-ms)
 *   src / dst IP address strings (IPv4 or IPv6)
 *   sport     local bound port (host byte order)
 *   dport     remote peer port (host byte order)
 *   snd_cwnd  congestion window (MSS units)
 *   ssthresh  slow-start threshold (MSS units; 2147483647 = no limit)
 *   snd_wnd   receiver-advertised window (bytes)
 *   srtt_us   smoothed RTT (µs; derived from tp->srtt_us >> 3)
 *   rcv_wnd   local receive window (bytes)
 */

BEGIN
{
    printf("# nsecs src sport dst dport snd_cwnd ssthresh snd_wnd srtt_us rcv_wnd\n");
}

kprobe:tcp_rcv_established
{
    $sk  = (struct sock *)arg0;
    $tcp = (struct tcp_sock *)arg0;

    $family = $sk->__sk_common.skc_family;
    $sport  = (uint16)$sk->__sk_common.skc_num;       /* local port, host byte order */
    $dport  = bswap((uint16)$sk->__sk_common.skc_dport); /* remote port, network→host */

    $snd_cwnd  = $tcp->snd_cwnd;
    $ssthresh  = $tcp->snd_ssthresh;
    $snd_wnd   = $tcp->snd_wnd;
    $srtt_us   = $tcp->srtt_us >> 3;   /* kernel stores 8× actual RTT */
    $rcv_wnd   = $tcp->rcv_wnd;

    if ($family == 2) {
        printf("%llu %s %u %s %u %u %u %u %u %u\n",
            nsecs,
            ntop($sk->__sk_common.skc_rcv_saddr), $sport,
            ntop($sk->__sk_common.skc_daddr),     $dport,
            $snd_cwnd, $ssthresh, $snd_wnd, $srtt_us, $rcv_wnd);
    } else if ($family == 10) {
        printf("%llu %s %u %s %u %u %u %u %u %u\n",
            nsecs,
            ntop($sk->__sk_common.skc_v6_rcv_saddr.in6_u.u6_addr8), $sport,
            ntop($sk->__sk_common.skc_v6_daddr.in6_u.u6_addr8),     $dport,
            $snd_cwnd, $ssthresh, $snd_wnd, $srtt_us, $rcv_wnd);
    }
}
