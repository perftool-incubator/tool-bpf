{
    "presets": {
        "defaults" : [
            { "arg": "subtools", "vals": ["tcp-window"] },
            { "arg": "interval", "vals": ["10"] },
            { "arg": "iface", "vals": ["ens1f0np0"] }
        ]
    },
    "validations": {
        "subtool_list" : {
            "description" : "comma-separated list of bpf subtools to run, any combination of tcp-window/tx-burst",
            "args" : [ "subtools" ],
            "vals": "^(tcp-window|tx-burst)(,(tcp-window|tx-burst))*$"
        },
        "positive_integer" : {
            "description" : "a whole number greater than 0",
            "args" : [ "interval" ],
            "vals": "^[1-9][0-9]*$"
        },
        "interface_name" : {
            "description" : "network interface name for packet tracing (e.g. ens1f0np0, eth0)",
            "args" : [ "iface" ],
            "vals": "^[A-Za-z0-9_.-]+$"
        }
    }
}
